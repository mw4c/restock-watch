# Copy this file to ".env" and fill it in. NEVER commit .env to git.

# Dashboard login (min 12 characters)
ADMIN_PASSWORD=change-me-to-something-long

# Random string for signing login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Telegram alerts — see README step 2
TELEGRAM_BOT_TOKEN=
# Optional: leave blank and use the "Connect Telegram" button instead
TELEGRAM_CHAT_ID=

# Shops the bot is allowed to check (comma-separated, exact hostnames)
ALLOWED_HOSTS=www.dyson.com.sg,dyson.com.sg,www.courts.com.sg,www.fairprice.com.sg,www.harveynorman.com.sg,www.bestdenki.com.sg

# Set to true once deployed behind https://
SECURE_COOKIES=false
PORT=3000
